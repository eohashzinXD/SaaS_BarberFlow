generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                           String              @id @default(cuid())
  name                         String
  slug                         String              @unique
  billingStatus                BillingStatus       @default(PENDING_PAYMENT)
  billingCustomerId            String?             @unique
  billingSubscriptionId        String?             @unique
  subscriptionStartDate        DateTime?
  subscriptionCurrentPeriodEnd DateTime?
  gracePeriodDays              Int                 @default(0)
  isBlocked                    Boolean             @default(false)
  blockedAt                    DateTime?
  blockedReason                String?
  createdAt                    DateTime            @default(now())
  profile                      BarbershopProfile?
  users                        User[]
  barbers                      Barber[]
  services                     Service[]
  appointments                 Appointment[]
  businessHours                BusinessHour[]
  pendingSignups               PendingSignup[]
  activityLogs                 TenantActivityLog[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  tenantId     String?
  isBlocked    Boolean  @default(false)
  blockedAt    DateTime?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  auditLogs    TenantActivityLog[] @relation("TenantActivityActor")

  @@index([tenantId])
}

model TenantActivityLog {
  id          String   @id @default(cuid())
  tenantId     String
  actorUserId  String?
  action       String
  description  String
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser    User?    @relation("TenantActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId])
}

model BarbershopProfile {
  id          String  @id @default(cuid())
  tenantId    String  @unique
  description String?
  address     String?
  phone       String?
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Barber {
  id           String        @id @default(cuid())
  name         String
  tenantId     String
  createdAt    DateTime      @default(now())
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([tenantId])
}

model Service {
  id              String        @id @default(cuid())
  name            String
  description     String?
  durationMinutes Int
  price           Decimal       @db.Decimal(10, 2)
  tenantId        String
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@index([tenantId])
}

model Appointment {
  id            String            @id @default(cuid())
  tenantId      String
  barberId      String
  serviceId     String
  customerName  String
  customerEmail String
  startAt       DateTime
  endAt         DateTime
  status        AppointmentStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barber        Barber            @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service       Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, startAt])
  @@index([tenantId, barberId, startAt])
  @@index([serviceId])
}

model BusinessHour {
  id        String   @id @default(cuid())
  tenantId  String
  weekday   Int
  startTime String
  endTime   String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, weekday])
  @@index([tenantId])
}

model PendingSignup {
  id                      String             @id @default(cuid())
  ownerName               String
  email                   String
  passwordHash            String
  barbershopName          String
  slug                    String
  status                  PendingSignupStatus @default(PENDING_PAYMENT)
  billingCheckoutId       String?            @unique
  billingCustomerId       String?
  billingSubscriptionId   String?
  tenantId                String?
  completedAt             DateTime?
  expiresAt               DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  tenant                  Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([slug, status])
  @@index([tenantId])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PendingSignupStatus {
  PENDING_PAYMENT
  CHECKOUT_OPEN
  PAID
  PROVISIONED
  EXPIRED
  CANCELED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELED
  DONE
}
